# Browser cache policy (read by Netlify and Cloudflare Pages; Vercel uses
# vercel.json, GitHub Pages ignores both).
#
# /static is everything Vite emits with a content hash in the filename (JS,
# CSS, resized images), so it can be cached forever: a change produces a new
# URL. Files copied verbatim from public/ keep their names, so they get a
# shorter lifetime and revalidate in the background.

/static/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/animations/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate
